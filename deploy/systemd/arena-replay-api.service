# systemd user unit. Installed by scripts/install_services.sh (@REPO_DIR@ is replaced).
[Unit]
Description=ArenaReplay API
Documentation=file://@REPO_DIR@/README.md

[Service]
Type=simple
WorkingDirectory=@REPO_DIR@
Environment=PYTHONUNBUFFERED=1
ExecStart=@REPO_DIR@/.venv/bin/python -m replay.api
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=15

[Install]
WantedBy=default.target

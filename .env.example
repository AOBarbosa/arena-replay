# PostgreSQL credentials (used by docker-compose.yml)
POSTGRES_USER=arena
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=arena_replay
# Port published on 127.0.0.1 on the host
POSTGRES_PORT=5432

# URL used by the Python services (psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://arena:change-this-password@127.0.0.1:5432/arena_replay
# Test database, created automatically by the container on first start
TEST_DATABASE_URL=postgresql+psycopg://arena:change-this-password@127.0.0.1:5432/arena_replay_test

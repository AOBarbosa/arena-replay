# Credenciais do PostgreSQL (usadas pelo docker-compose.yml)
POSTGRES_USER=arena
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=arena_replay
# Porta publicada em 127.0.0.1 no host
POSTGRES_PORT=5432

# URL usada pelos serviços Python (driver psycopg 3)
DATABASE_URL=postgresql+psycopg://arena:troque-esta-senha@127.0.0.1:5432/arena_replay
# Banco de testes, criado automaticamente pelo container na primeira inicialização
TEST_DATABASE_URL=postgresql+psycopg://arena:troque-esta-senha@127.0.0.1:5432/arena_replay_test
